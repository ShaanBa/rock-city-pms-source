DATABASE_URL=postgresql://username:password@localhost:5432/pms
POSTGRES_PASSWORD=replace-with-a-random-local-password
PORT=3000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001
STAFF_API_KEY=replace-with-at-least-32-random-characters
IMPORT_API_KEY=replace-with-a-different-32-character-random-value
REQUEST_BODY_LIMIT_BYTES=65536
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
PAYMENT_RATE_LIMIT_MAX=20
IMPORT_RATE_LIMIT_MAX=30

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
PUBLIC_BOOKING_PAUSED=true

