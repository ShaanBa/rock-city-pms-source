# Local development
# VITE_API_URL=http://localhost:3001

# On-site LAN: leave VITE_API_URL unset
# UI auto-calls http://<same-host-as-browser>:3000/api/...
# pm2 locks PORT=3000 in ecosystem.config.cjs

# Cloud API for web assignment
VITE_CLOUD_API_URL=https://api.rockcitymotel.com

# Generate separate random values; backend must use the matching keys.
VITE_STAFF_API_KEY=replace-with-at-least-32-random-characters
VITE_IMPORT_API_KEY=replace-with-a-different-32-character-random-value
